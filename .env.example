# Shared secret and credentials template.
# Copy to .env (git-ignored) or run scripts/generar-env.sh to create it.
# Never commit real values.
JWT_SECRET=
JWT_SECRET_BASE64=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=authcoredb
MYSQL_USER=authcore
MYSQL_PASSWORD=
POSTGRES_DB=ferreteria
POSTGRES_USER=ferreteria
POSTGRES_PASSWORD=
NEGOCIO_NOMBRE=
NEGOCIO_NIT=
NEGOCIO_DIRECCION=
NEGOCIO_TELEFONO=
NEGOCIO_CIUDAD=

# Current AdminBootstrapRunner default; AuthCore ignores this variable until D2 is resolved.
ADMIN_PASSWORD=admin123
